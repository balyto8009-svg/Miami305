# ============================================
# CONFIGURACIÓN DEL PROYECTO MIAMI305
# SISTEMA DE ENVÍOS A CUBA
# ============================================
# ¡NO SUBIR ESTE ARCHIVO A GIT!
# ============================================

# ============================================
# DJANGO - CONFIGURACIÓN PRINCIPAL
# ============================================
# Clave secreta - ¡CÁMBIALA!
# Puedes generar una nueva en: https://djecrety.ir/
DJANGO_SECRET_KEY='django-insecure-@8x5&3%9k#m2!p7q*w4e6r8t9y0u1i2o3p4a5s6d7f8g9h0j1k2l3z4x5c6v7b8n9m0'

# Modo debug (True para desarrollo, False para producción)
DJANGO_DEBUG=True

# Hosts permitidos (separados por coma)
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# ============================================
# BASE DE DATOS - POSTGRESQL
# ============================================
# IMPORTANTE: Debes crear esta base de datos en PostgreSQL
# Abre pgAdmin o psql y ejecuta:
# CREATE DATABASE envios_cuba;
# CREATE USER envios_user WITH PASSWORD 'tu_contraseña';
# GRANT ALL PRIVILEGES ON DATABASE envios_cuba TO envios_user;

DB_NAME=envios_cuba
DB_USER=envios_user
DB_PASSWORD=admin123
DB_HOST=localhost
DB_PORT=5432

# ============================================
# CORS - PARA COMUNICACIÓN CON REACT
# ============================================
# Orígenes permitidos (frontend de React)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,http://localhost:5174

# ============================================
# EMAIL - PARA NOTIFICACIONES (OPCIONAL)
# ============================================
# Opción 1: Usar Gmail (recomendado usar contraseña de aplicación)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=tu_correo@gmail.com
EMAIL_HOST_PASSWORD=tu_contrasea_de_aplicacion
DEFAULT_FROM_EMAIL=envios@miami305.com

# Opción 2: Si no tienes email, usa consola (descomenta la línea de abajo)
# EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend

# ============================================
# REDIS - PARA TAREAS ASÍNCRONAS (OPCIONAL)
# ============================================
# Si no tienes Redis, puedes ignorar esta sección
REDIS_URL=redis://localhost:6379/0

# ============================================
# ALMACENAMIENTO DE ARCHIVOS
# ============================================
# Directorio donde se guardarán las fotos de los paquetes
MEDIA_ROOT=D:/Universidad/Tesis/Miami305/media
MEDIA_URL=/media/

# Directorio de archivos estáticos
STATIC_ROOT=D:/Universidad/Tesis/Miami305/staticfiles
STATIC_URL=/static/

# ============================================
# SEGURIDAD (SOLO PARA PRODUCCIÓN)
# ============================================
# Descomenta estas líneas solo en producción con HTTPS
# SECURE_SSL_REDIRECT=True
# SESSION_COOKIE_SECURE=True
# CSRF_COOKIE_SECURE=True
# SECURE_HSTS_SECONDS=31536000
# SECURE_HSTS_INCLUDE_SUBDOMAINS=True
# SECURE_HSTS_PRELOAD=True

# ============================================
# CONFIGURACIÓN DE LOGS
# ============================================
LOG_LEVEL=DEBUG
LOG_FILE=D:/Universidad/Tesis/Miami305/logs/django.log

# ============================================
# API - CONFIGURACIÓN DE DJANGO REST FRAMEWORK
# ============================================
API_PAGE_SIZE=20
API_MAX_PAGE_SIZE=100

# ============================================
# CONFIGURACIÓN DE LA EMPRESA
# ============================================
EMPRESA_NOMBRE=Miami305 Envíos
EMPRESA_DIRECCION=123 Main Street, Miami, FL 33101
EMPRESA_TELEFONO=+1 (305) 555-0123
EMPRESA_EMAIL=info@miami305.com
EMPRESA_SITIO_WEB=https://www.miami305.com

# ============================================
# TARIFAS DE ENVÍO (Configuración inicial)
# ============================================
# Tarifa base por kilo (USD)
TARIFA_BASE=15.00
# Tarifa por kilo adicional después del peso base
TARIFA_KG_EXTRA=2.50
# Peso base para cálculo de tarifa (kg)
PESO_BASE=2.00
# Sobrecargo para provincias lejanas (USD)
SOBRECARGO_PROVINCIA_LEJANA=3.00

# ============================================
# OTRAS CONFIGURACIONES
# ============================================
# Zona horaria
TIME_ZONE=America/New_York
# Idioma
LANGUAGE_CODE=es-es